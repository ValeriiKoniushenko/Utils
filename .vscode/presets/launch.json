{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug UtilsTests (GCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/UtilsTests",
            "args": [],
            "cwd": "${workspaceFolder}/build/bin/",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug UtilsTests (Clang)",
